{
  "name": "boilerplate-server",
  "version": "1.0.0",
  "description": "Boilerplate",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "cd ./src && cross-env NODE_ENV=production node index.js",
    "start-dev": "cd ./src && cross-env NODE_ENV=development node index.js",
    "install-start": "npm run setup && npm start",
    "install-start-dev": "npm run setup && npm run start-dev",
    "setup": "npm install",
    "heroku-postbuild": "cp ./src/env.example.js ./src/env.js"
  },
  "author": "PRO FORWARD",
  "dependencies": {
    "body-parser": "1.20.3",
    "dotenv": "17.2.1",
    "errorhandler": "1.5.0",
    "express": "4.21.2",
    "express-jwt": "8.5.1",
    "express-session": "1.18.2",
    "generate-password": "1.7.1",
    "google-libphonenumber": "3.0.10",
    "graceful-fs": "4.1.11",
    "jsonwebtoken": "9.0.2",
    "lodash": "4.17.21",
    "moment": "2.30.1",
    "morgan": "1.10.1",
    "mysql2": "^3.14.3",
    "node-schedule": "1.2.5",
    "nodemailer": "7.0.5",
    "passport": "0.7.0",
    "passport-local": "1.0.0",
    "password-hash": "latest",
    "pug": "3.0.3",
    "s3": "2.0.0",
    "sequelize": "6.37.7"
  },
  "devDependencies": {
    "cross-env": "10.0.0"
  }
}
